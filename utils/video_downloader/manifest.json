{
  "manifest_version": 3,
  "name": "RYA.AE — Video Downloader",
  "version": "2.6",
  "description": "YouTube/VK/Rutube/OK: one video at max quality with its whole package, or a whole channel — every video, plus stats and comments as CSV",
  "key": "",
  "permissions": ["activeTab", "downloads", "scripting", "nativeMessaging", "storage", "contextMenus", "notifications"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
