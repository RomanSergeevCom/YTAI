#!/bin/bash
# ytai_load — флаг нагрузки для мониторинга Memex/мака: тяжёлый локальный джоб (VLM, LLM, whisper, рендер)
# ставит флаг, и тревоги температуры подписываются «идёт <job>», а не «аномалия».
#
#   ytai_load start "RSC004 проверка иллюстраций (Qwen2.5-VL)" 60     # job, ожидаемо минут
#   ytai_load stop
#   ytai_load status
#   ytai_load run "RSC004 VLM" 60 -- python3 vlm_pass.py …             # поставить, выполнить, снять
#
# Флаг: ~/.cache/ytai/LOAD.json {"job","code","stage","started","expected_min","host","note"} — тот же,
# что пишет review.py на тяжёлых стадиях; memex-temp-check.sh читает его.
set -u
F="$HOME/.cache/ytai/LOAD.json"
case "${1:-status}" in
  start)
    mkdir -p "$(dirname "$F")"
    python3 - "$2" "${3:-60}" "$F" <<'EOF'
import json, sys, socket, datetime
job, mins, f = sys.argv[1], int(sys.argv[2]), sys.argv[3]
json.dump({"job": job, "code": "", "stage": job, "started": datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
           "expected_min": mins, "host": socket.gethostname(), "note": f"{job} — высокая нагрузка ожидаема ~{mins} мин"},
          open(f, 'w'), ensure_ascii=False)
print(f"флаг нагрузки: {job}, ~{mins} мин → {f}")
EOF
    ;;
  stop)  rm -f "$F"; echo "флаг нагрузки снят" ;;
  status) [ -f "$F" ] && cat "$F" && echo || echo "флага нет — нагрузка не заявлена" ;;
  run)
    shift; job=$1; mins=$2; shift 2; [ "${1:-}" = "--" ] && shift
    "$0" start "$job" "$mins"; "$@"; rc=$?; "$0" stop; exit $rc ;;
  *) sed -n '2,12p' "$0"; exit 2 ;;
esac
