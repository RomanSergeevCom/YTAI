{
  "id": "com.ytai.brief.panel",
  "name": "YTAI Brief",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.0.0"
  },
  "manifestVersion": 6,
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite",
    "network": {
      "domains": "all"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "com.ytai.brief.mainPanel",
      "label": {
        "default": "YTAI Brief"
      },
      "minimumSize": {
        "width": 320,
        "height": 400
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 600
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 600
      }
    }
  ]
}
