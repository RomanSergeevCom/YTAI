{
  "id": "com.ytai.brief.panel",
  "name": "YTAI Brief",
  "version": "1.0.19",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.3.0"
  },
  "manifestVersion": 6,
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite",
    "network": {
      "domains": "all"
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "com.ytai.brief.mainPanel",
      "label": { "default": "YTAI Brief" },
      "minimumSize": { "width": 320, "height": 450 },
      "preferredDockedSize": { "width": 420, "height": 700 }
    },
    {
      "type": "command",
      "id": "com.ytai.brief.loadBrief",
      "label": { "default": "YTAI: Load Brief" }
    },
    {
      "type": "command",
      "id": "com.ytai.brief.buildSequence",
      "label": { "default": "YTAI: Build Sequence" }
    }
  ]
}
